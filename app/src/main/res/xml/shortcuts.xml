<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher's long-press menu: straight to the Codes view, a tile per one-time code (SPEC §6.2); a quick note from the
     clipboard, over whatever is in front (SPEC §6.4). -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_codes"
        android:shortcutId="codes"
        android:shortcutLongLabel="@string/shortcut_codes_long"
        android:shortcutShortLabel="@string/shortcut_codes">
        <intent
            android:action="dev.keething.android.action.CODES"
            android:targetClass="dev.keething.android.MainActivity"
            android:targetPackage="dev.keething.android" />
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_note"
        android:shortcutId="note-from-clipboard"
        android:shortcutLongLabel="@string/shortcut_note_from_clipboard_long"
        android:shortcutShortLabel="@string/shortcut_note_from_clipboard">
        <intent
            android:action="dev.keething.android.action.NOTE_FROM_CLIPBOARD"
            android:targetClass="dev.keething.android.quicknote.QuickNoteActivity"
            android:targetPackage="dev.keething.android" />
    </shortcut>
</shortcuts>
