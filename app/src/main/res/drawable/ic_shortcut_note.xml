<?xml version="1.0" encoding="utf-8"?>
<!-- The "Note from clipboard" shortcut: Material icon "content_paste" (Apache License 2.0), as large as the Codes
     shortcut's ring, on the launcher's own white plate; with themed icons on, the launcher may draw the monochrome
     layer in the theme's colours instead. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@android:color/white" />
    <foreground android:drawable="@drawable/ic_shortcut_note_glyph" />
    <monochrome android:drawable="@drawable/ic_shortcut_note_glyph" />
</adaptive-icon>
