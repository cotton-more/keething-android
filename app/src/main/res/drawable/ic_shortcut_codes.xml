<?xml version="1.0" encoding="utf-8"?>
<!-- The "Codes" shortcut: icon A, "the ring" (keething-spec app.codes-view), large on the launcher's own white plate
     (the one it gives any shortcut, white at night too); with themed icons on, the launcher may draw the monochrome
     layer in the theme's colours instead. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@android:color/white" />
    <foreground android:drawable="@drawable/ic_shortcut_codes_glyph" />
    <monochrome android:drawable="@drawable/ic_shortcut_codes_glyph" />
</adaptive-icon>
