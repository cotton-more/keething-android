<resources>
    <!-- Autofill's dropdown rows (SPEC §7), drawn by the system over the app being filled. -->
    <color name="autofill_title">@android:color/system_neutral1_900</color>
    <color name="autofill_subtitle">@android:color/system_neutral2_700</color>
    <color name="autofill_icon">@android:color/system_accent1_600</color>
    <!-- The launcher shortcuts' glyphs (SPEC §6.2) on the launcher's white plate, in the system's colours: dark in
         both themes, as the launcher keeps the plate white at night too. -->
    <color name="shortcut_glyph">@android:color/system_accent1_600</color>
</resources>
