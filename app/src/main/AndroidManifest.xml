<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The fingerprint unlock (SPEC §5). -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!--
    New database (SPEC §6.2): a short foreground service keeps the process for the seconds Create writes the file, so
    removing the app from recents does not leave it half-made. No notification permission is asked: it runs without.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- Reading the code of a request or an answer (SPEC §10); asked for only when reading one. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!--
    No storage permission (keething-spec databases.saf AC1): every database and key file is reached through a folder or
    a file the user chose in the system's picker (SPEC §3.1).
    -->

    <!--
    Autofill (SPEC §7): the websites an app is verified for are shown only to an app that can see it. A fill
    request does not make the app being filled visible to the service (checked on the test phone), and the
    apps cannot be named in advance. The app has no network: what it sees of the installed apps stays here.
    -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!--
    largeHeap: opening the 35 MB database holds several copies of it for a moment, plus 64 MiB for Argon2
    (ROADMAP step 2).
    -->
    <application
        android:name=".KeethingApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:theme="@style/Theme.Keething">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- The "Codes" launcher shortcut (SPEC §6.2). -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <receiver
            android:name=".session.LockAlarmReceiver"
            android:exported="false" />
        <receiver
            android:name=".clipboard.ClipboardClearReceiver"
            android:exported="false" />
        <receiver
            android:name=".sharing.ChosenAppReceiver"
            android:exported="false" />

        <service
            android:name=".databases.CreatingService"
            android:exported="false"
            android:foregroundServiceType="shortService" />

        <!-- Autofill (SPEC §7): the service, and the screen it opens over the app being filled. -->
        <service
            android:name=".autofill.KeethingAutofillService"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <meta-data
                android:name="android.autofill"
                android:resource="@xml/autofill_service" />
        </service>
        <activity
            android:name=".autofill.AutofillActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Theme.Keething.Autofill"
            android:windowSoftInputMode="adjustResize" />
        <!-- Autofill's save offer, opened by the system after its "Save to Keething?" (SPEC §7). -->
        <activity
            android:name=".autofill.SaveLoginActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!--
        "Read with Keething" in the share sheet (SPEC §10): a picture or a text with a code from a messenger or mail.
        Its own see-through screen in no task of the app's (an empty affinity), so the main one never opens inside the
        other app's task and a share always reaches it, also while the app is open.
        -->
        <activity
            android:name=".sharing.ReceiveCodeActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/read_with_keething"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Keething.Autofill">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <!--
        Keething note in the share sheet and the text selection menu (SPEC §6.4): a quick note from another app's text,
        in a sheet over that app. A task of its own for each share (documentLaunchMode: a second share would otherwise
        bring the first one's task back and drop its text); the selection menu, started for a result, opens it in the
        caller's task. Never in Recents nor kept across a restart, and it finishes itself when stopped; it returns no
        result, so a selected text stays as it was.
        -->
        <activity
            android:name=".quicknote.QuickNoteActivity"
            android:documentLaunchMode="always"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/keething_note"
            android:persistableMode="persistNever"
            android:taskAffinity=""
            android:theme="@style/Theme.Keething.Autofill"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- The Quick note tile (SPEC §6.4): the quick note's screen with the clipboard's text. -->
        <service
            android:name=".quicknote.QuickNoteTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_quick_note"
            android:label="@string/tile_quick_note"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- The pictures of requests and answers, handed to a messenger or mail (SPEC §10). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.sharing"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/sharing_paths" />
        </provider>

        <!-- Attachments opened in another app, read-only (SPEC §4). -->
        <provider
            android:name=".attachment.AttachmentProvider"
            android:authorities="${applicationId}.attachments"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/attachment_paths" />
        </provider>
    </application>

</manifest>
